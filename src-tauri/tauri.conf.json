{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintA4 Studio",
  "version": "0.1.0",
  "identifier": "com.printa4.studio",
  "build": {
    "beforeDevCommand": "bun run dev -- --port 3100 --host 127.0.0.1",
    "devUrl": "http://localhost:3100",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrintA4 Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}